# ─── Base de données ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catalogue
# Utilisés par docker-compose (service postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=catalogue

# ─── Serveur (Elysia) ───────────────────────────────────────────────
# NE PAS définir PORT ici pour le dev local : le .env est partagé aux deux apps,
# et Nuxt lit aussi PORT (il prendrait le 4000 de l'API). L'API écoute 4000 par
# défaut, Nuxt 3000. En Docker, le PORT de chaque service est fixé dans compose.
# Origines autorisées (CORS + cookies), séparées par des virgules
TRUSTED_ORIGINS=http://localhost:3000

# ─── Authentification (Better Auth) ─────────────────────────────────
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=change-me-with-a-long-random-string
# Domaine imposé pour l'email/mot de passe (optionnel)
AUTH_DOMAIN=

# ─── SSO OIDC ───────────────────────────────────────────────────
# Les anciens noms `OUATE_*` restent lus en repli : une instance déjà déployée n'a rien à
# changer ici. Quand les deux sont renseignés, `OIDC_*` l'emporte.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
# Identifiant du fournisseur. Il entre dans l'URL de rappel
# (/api/auth/oauth2/callback/<id>) et doit donc correspondre à ce qui est déclaré chez le
# fournisseur. Défaut : « ouate » — le nom historique, conservé pour ne pas invalider les
# URL de rappel déjà déclarées.
OIDC_PROVIDER_ID=
# Adresse de l'instance Nextcloud : sert à construire l'URL des photos de profil
# (${OIDC_NC_URL}/avatar/<id fédéré>/512). Facultative — sans elle, initiales locales.
OIDC_NC_URL=
# Déploiement sous-chemin (BASE_PATH) UNIQUEMENT : URL de callback OIDC complète, incluant le
# sous-chemin (le reverse retire le préfixe, sinon le callback l'omettrait). À déclarer aussi
# côté fournisseur. Ex. https://sso.example.org/catalogue/api/auth/oauth2/callback/ouate
OIDC_REDIRECT_URI=
# RETOUR DE BOUCLE — à renseigner si le SSO échoue en 500 avec « ConnectionRefused » dans
# les journaux du serveur. Le conteneur va chercher OIDC_DISCOVERY_URL à l'adresse
# PUBLIQUE ; depuis le réseau Docker, ce nom résout souvent vers une adresse injoignable
# (NAT sans retour de boucle, pare-feu). Le nom indiqué ici est routé vers la passerelle de
# l'hôte, donc vers son nginx — le certificat TLS reste valable puisque le nom ne change pas.
# Ex. AUTH_HOST_INTERNE=sso.example.org
AUTH_HOST_INTERNE=

# ─── Connecteur Sniff (incidents) ───────────────────────────────────
# MÊME RETOUR DE BOUCLE que ci-dessus, pour le nom public de Sniff : si le test de
# connexion du connecteur répond « Unable to connect » alors que l'URL marche dans un
# navigateur, c'est que le conteneur ne joint pas ce nom. Indiquer ici l'HÔTE de l'URL
# saisie dans Réglages → Incidents (Sniff) ; il sera routé vers le nginx de l'hôte.
# Ex. SNIFF_HOST_INTERNE=sniff.example.org
SNIFF_HOST_INTERNE=

# ─── Notifications push (Web Push / VAPID) ──────────────────────────
# Engendrer une paire — DEPUIS apps/server (web-push y est déclaré, pas à la racine) :
#   cd apps/server && bun -e "import w from 'web-push'; const k=w.generateVAPIDKeys(); console.log(k.publicKey, k.privateKey)"
# Ou depuis le conteneur : docker compose exec server bun -e "…" (voir doc/Installation.md)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cyber@example.org

# ─── Frontend (Nuxt) ────────────────────────────────────────────────
NUXT_PUBLIC_SERVER_BASE_URL=http://localhost:4000

# ─── Déploiement Docker (docker-compose) ────────────────────────────
# Port exposé sur l'hôte par le reverse proxy interne.
APP_PORT=8080
# Origine publique (schéma + hôte, SANS chemin ni slash final). Ex. https://catalogue.example.org
PUBLIC_URL=http://localhost:8080
# Sous-chemin de déploiement derrière un reverse proxy (ex. l'hôte qui transmet la requête
# telle quelle). Vide = à la racine. Sinon LEADING slash, PAS de trailing slash. Ex. /catalogue
# → l'app est servie sur ${PUBLIC_URL}${BASE_PATH} (ex. https://sso.example.org/catalogue).
# Compose en dérive : NUXT_APP_BASE_URL, NUXT_PUBLIC_SERVER_BASE_URL, BETTER_AUTH_URL, et le nginx interne.
BASE_PATH=
