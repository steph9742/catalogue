{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".nuxt/**",
                ".output/**",
                "dist/**"
            ]
        },
        "lint": {},
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    },
    "ui": "tui",
    "globalEnv": [
        "DATABASE_URL",
        "PORT",
        "HOST",
        "TRUSTED_ORIGINS",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "AUTH_DOMAIN",
        "OUATE_CLIENT_ID",
        "OUATE_CLIENT_SECRET",
        "OUATE_DISCOVERY_URL",
        "OUATE_NC_URL",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "NUXT_PUBLIC_SERVER_BASE_URL"
    ]
}
